{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jairveloso21-coder/a-casa-core/tree/main/integracoes/edicao_video/biblioteca_semantica/schema.json",
  "title": "CASA Semantic Video Private Timeline v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "annotation_visibility",
    "sources",
    "events",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": "casa.semantic-video/1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "annotation_visibility": {
      "const": "private_only"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "origin",
          "immutable",
          "duration_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "const": "raw_capture"
          },
          "immutable": {
            "const": true
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "start_seconds",
          "end_seconds",
          "event_type",
          "description_pt",
          "evidence_seconds",
          "depends_on",
          "result_observed",
          "confidence",
          "render_as_overlay"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "event_type": {
            "enum": [
              "setup",
              "action",
              "consequence",
              "payoff",
              "low_information"
            ]
          },
          "description_pt": {
            "type": "string",
            "minLength": 1
          },
          "evidence_seconds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result_observed": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "render_as_overlay": {
            "const": false
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "in_seconds",
          "out_seconds",
          "event_ids",
          "editorial_reason"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "in_seconds": {
            "type": "number",
            "minimum": 0
          },
          "out_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "editorial_reason": {
            "type": "string",
            "minLength": 1
          },
          "transition_reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
